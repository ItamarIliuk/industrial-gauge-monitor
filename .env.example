# ==============================================================================
# Configurações do Projeto Industrial Gauge Monitor
# Copie este arquivo para .env ou configure as variáveis no seu ambiente.
# NUNCA insira chaves privadas ou tokens confidenciais neste arquivo!
# ==============================================================================

# Identificação do Projeto no Google Cloud
GOOGLE_CLOUD_PROJECT=seu-projeto-gcp-aqui
GOOGLE_CLOUD_REGION=us-central1

# Tópico Pub/Sub e Recursos BigQuery
TOPIC_ID=telemetry-manometer
BQ_DATASET=telemetry_db
BQ_TABLE=manometer_readings

# Identificador do Dispositivo Edge
DEVICE_ID=manometro-caldeira-01

# Modelo Gemini (Vertex AI MaaS)
MODEL_ID=gemini-3.6-flash

# Configurações de Câmera e Captura
CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720

# Intervalo entre leituras (segundos)
CYCLE_INTERVAL=60

# Calibração de ROI (Região de Interesse - LGPD)
ROI_Y_START=150
ROI_Y_END=450
ROI_X_START=200
ROI_X_END=500
ROI_BASE_WIDTH=640
ROI_BASE_HEIGHT=480

# Simulação (true para rodar com imagem local sem câmera física)
USE_SIMULATION_IMAGE=false
SIMULATION_IMAGE_PATH=20260518_200005.jpg

# Caminho para credenciais locais (fora da pasta do repositório)
# Windows: %USERPROFILE%\.config\gcp\edge-sa-key.json
# Linux/Mac: ~/.config/gcp/edge-sa-key.json
# GOOGLE_APPLICATION_CREDENTIALS=C:\Users\SEU_USUARIO\.config\gcp\edge-sa-key.json
